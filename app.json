{
  "expo": {
    "name": "Veedu",
    "slug": "veedu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "veedu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.veedu.household"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E7A5C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.veedu.household"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7A5C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Veedu uses the camera to photograph product labels and shopping notes so you do not have to type them.",
          "photosPermission": "Veedu reads photos you choose of product labels and shopping notes so you do not have to type them."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Veedu uses the camera to scan barcodes and photograph product labels and shopping notes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
